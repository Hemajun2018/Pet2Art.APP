# -----------------------------------------------------------------------------
# 环境变量配置模板 - 复制为 .env.local 并填入实际值
# -----------------------------------------------------------------------------

# =============================================================================
# 基础配置
# =============================================================================

# 网站基础信息
NEXT_PUBLIC_WEB_URL = "http://localhost:3000"  # 生产环境改为你的域名
NEXT_PUBLIC_PROJECT_NAME = "Pet2Art"

# NextAuth 认证密钥
AUTH_SECRET = "your-auth-secret-key-here"

# =============================================================================
# Supabase 数据库配置
# =============================================================================
SUPABASE_URL = "your-supabase-url"
SUPABASE_ANON_KEY = "your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY = "your-supabase-service-role-key"

# =============================================================================
# AI 生图 API 配置（重要：前端直接调用）
# =============================================================================
# Pet AI API - 前端直接调用以避免 Vercel 超时
NEXT_PUBLIC_PET_AI_API_KEY = "your-pet-ai-api-key"
NEXT_PUBLIC_PET_AI_API_URL = "https://api.apicore.ai/v1/images/edits"

# 后端备用（可选）
PET_AI_API_KEY = "your-pet-ai-api-key"
PET_AI_API_URL = "https://api.apicore.ai/v1/images/edits"

# =============================================================================
# 其他配置（根据需要配置）
# =============================================================================

# Google 登录
AUTH_GOOGLE_ID = "your-google-client-id"
AUTH_GOOGLE_SECRET = "your-google-client-secret"
NEXT_PUBLIC_AUTH_GOOGLE_ID = "your-google-client-id"
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED = "true"

# 支付配置（选择一个）
# Creem 支付
CREEM_API_KEY = "your-creem-api-key"
CREEM_WEBHOOK_SECRET = "your-creem-webhook-secret"
NEXT_PUBLIC_CREEM_ENABLED = "true"

# 或 Stripe 支付
STRIPE_PUBLIC_KEY = "your-stripe-public-key"
STRIPE_PRIVATE_KEY = "your-stripe-private-key"

# 存储配置 (Cloudflare R2 或其他S3兼容存储)
STORAGE_ENDPOINT = "your-storage-endpoint"
STORAGE_REGION = "auto"
STORAGE_ACCESS_KEY = "your-access-key"
STORAGE_SECRET_KEY = "your-secret-key"
STORAGE_BUCKET = "your-bucket-name"
STORAGE_DOMAIN = "your-cdn-domain"

# =============================================================================
# 邮件服务配置（重要：用于发送生成完成通知）
# =============================================================================
# Resend 免费邮件服务 (每月3000封免费邮件)
# 注册地址: https://resend.com
# 重要步骤：
# 1. 在 Resend 注册并获取 API Key
# 2. 添加并验证你的域名（DNS验证）
# 3. 使用验证后的域名作为发件地址
RESEND_API_KEY = "your-resend-api-key"
EMAIL_FROM = "YourApp <noreply@yourdomain.com>"  # 必须使用已验证的域名